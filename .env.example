# Hermes Agent Framework - Environment Variables
# 复制此文件为 .env 并填入你的配置

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 可以添加其他LLM的API密钥

# LLM Configuration
DEFAULT_MODEL=gpt-4
TEMPERATURE=0.7

# Vector Database
CHROMA_DB_PATH=./data/chroma

# Application Settings
LOG_LEVEL=INFO
DEBUG=true

